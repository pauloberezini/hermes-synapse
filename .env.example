# ====================================================================
# Hermes (Jarvis): Environment Configuration Template
# Copy this file to .env and fill in your keys.
# ====================================================================

# ── REQUIRED ─────────────────────────────────────────────────────────
# LLM inference via OpenRouter → https://openrouter.ai/keys
# Supports any model: Gemini, GPT-4o, Claude, DeepSeek, Llama, etc.
LLM_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=google/gemini-2.5-flash
# Local model: LLM_MODEL=ollama/llama3 and LLM_API_BASE=http://host.docker.internal:11434/v1

# ── OPTIONAL: Per-agent model overrides ──────────────────────────────
# Override the model used by each specialized agent role.
# Falls back to LLM_MODEL if not set.
#
# Recommended combinations:
# - Research: Fast & cheap (e.g., ollama/llama3, google/gemini-2.5-flash, deepseek/deepseek-chat)
# - Code: High-reasoning models (e.g., deepseek/deepseek-r1, ollama/llama3, anthropic/claude-sonnet-4.5)
# - Analyst: Fast & visually descriptive (e.g., ollama/llama3, google/gemini-2.5-flash, openai/gpt-4o)
# - Planner: Highly structured JSON output (e.g., ollama/llama3, google/gemini-2.5-flash, openai/gpt-4o-mini)
#
AGENT_MODEL_RESEARCH=ollama/llama3
AGENT_MODEL_CODE=deepseek/deepseek-r1
AGENT_MODEL_ANALYST=ollama/llama3
AGENT_MODEL_PLANNER=ollama/llama3
# Model for specialists the core hires when no existing agent covers a request.
# AGENT_MODEL_SPECIALIST=ollama/llama3
COMPLEXITY_ROUTING=false

# ── AUTO-HIRE ────────────────────────────────────────────────────────
# When no agent covers a request, the core creates one in the same turn.
# ask: create it and wait for confirmation (default). on: hire and run, hands-free. off: report the gap.
AUTO_HIRE=ask
AUTO_HIRE_MAX_PER_TURN=1
AUTO_HIRE_MAX_PER_DAY=10
AUTO_HIRE_ALLOW_RISKY=0
# Auto-hired agents with no use in this many days show up for cleanup. They are not deleted.
AUTO_HIRE_UNUSED_DAYS=30

# ── PILOT / COMPOSE SECRETS (required for `docker compose up`) ───────
# Generate with: openssl rand -hex 32
# `docker compose up` (ENV=production) refuses to start if these are
# unset or left as known defaults (postgres/password/secret/...).
# docker-compose.dev.yml does not require them.
POSTGRES_USER=hermes
POSTGRES_PASSWORD=
POSTGRES_DB=hermes
# DATABASE_URL is built by compose from the POSTGRES_* values above.
# Override only for a non-compose process (local uvicorn against a host DB).
# DATABASE_URL=postgresql://hermes:YOUR_PASSWORD@localhost:5432/hermes
QDRANT_API_KEY=
# Compose Qdrant is HTTP on the internal network. Set QDRANT_HTTPS=1 only for a TLS endpoint.
# QDRANT_HTTPS=0
# HS256 secret for OIDC JWT sessions. Production compose requires 32+ chars.
# Leave empty in local/dev to disable JWT login (OTP sessions still work).
JWT_SECRET=

# ── OPENAPI-TO-MCP HELPER (optional) ─────────────────────────────────
# backend/mcp_openapi_proxy.py wraps one REST spec. There is no default host.
# Unset OPENAPI_URL → the proxy exits instead of calling an external service.
# OPENAPI_URL=https://your-service.example/openapi.json
# AUTH_TOKEN_URL=https://your-service.example/token

# ── SYSTEM BACKEND ───────────────────────────────────────────────────
PORT=8000

# ── TELEGRAM INTERFACE ───────────────────────────────────────────────
# Agents: all agents are accessible via Telegram
# Create a bot via @BotFather → https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your numeric chat ID via @userinfobot → https://t.me/userinfobot
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Authorized admin user ID(s) that the bot will respond to (comma-separated if multiple; all others are blocked at code level)
TELEGRAM_ADMIN_ID=your_telegram_admin_id_here

# ── SEARCH AGENT & FOOTBALL ANALYST ─────────────────────────────────
# Skill: web_search — powers web search, news, football results
# SearXNG — open-source self-hosted metasearch
SEARXNG_URL=http://localhost:8080

# ── CALENDAR & TASKS ───────────────────────────────────────────────
# Optional: Set path to your downloaded Google client_secret.json for Calendar
GOOGLE_CLIENT_SECRET_PATH=~/.config/hermes/google_client_secret.json

# ── SEARCH AGENT: WEATHER ────────────────────────────────────────────
# Skill: web_search (weather sub-feature)
# OpenWeatherMap — free tier: 1,000 calls/day → https://home.openweathermap.org/api_keys
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# ── DAILY PLANNER: TODOIST ───────────────────────────────────────────
# Skill: todoist_sync
# Todoist → Settings → Integrations → Developer
# → https://app.todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=your_todoist_token_here

# ── DAILY PLANNER: GOOGLE CALENDAR ───────────────────────────────────
# Skill: google_calendar — OAuth2 setup (one-time, on host machine)
# 1. Create Desktop OAuth 2.0 credentials at:
#    https://console.cloud.google.com/apis/credentials
# 2. Download the JSON and place it in the project root as client_secret_*.json
# 3. Run once on your host: python3 backend/google_auth.py
#    This generates google_token.json which is volume-mounted into Docker.

# ── OBSIDIAN RAG SKILL ───────────────────────────────────────────────
# Skill: obsidian_rag — local knowledge base search & sync
# Install "Local REST API" plugin in Obsidian:
# → https://github.com/coddingtonbear/obsidian-local-rest-api
OBSIDIAN_API_KEY=your_obsidian_local_rest_api_key_here
OBSIDIAN_HOST=host.docker.internal
OBSIDIAN_PORT=27124
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# ── MARKET DATA PROVIDER ─────────────────────────────────────────────
# Skill: market_monitor — real-time price alerts for crypto & stocks
#
# MARKET_DATA_PROVIDER controls which backend fetches prices.
#   http    → Default. CoinGecko (crypto) + Yahoo Finance (stocks).
#             Zero config, zero API keys. Works out of the box.
#   <other> → Resolved by an installed plugin via the market_data_provider(name)
#             hook (see backend/plugins.py). Falls back to http if none answers.
MARKET_DATA_PROVIDER=http

# ── STRIPE CONNECT MARKETPLACE (optional) ────────────────────────────
# Leave empty unless you are wiring marketplace billing. A non-empty
# STRIPE_SECRET_KEY activates StripeBillingAdapter.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── HUGGING FACE TOKEN (FastEmbed / Vector Embeddings) ────────────────
HF_TOKEN=your_huggingface_token_here
HUGGING_FACE_HUB_TOKEN=your_huggingface_token_here
